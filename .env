
# .env
#
# Make sure this file is included in your .gitignore to avoid exposing sensitive information
# 
# This file defines the environment variables for Firebase configuration.
# Replace the placeholder values with your actual Firebase project settings.
# Note: VITE_ prefix is required for Vite to expose these variables to the client-side code
#
# Copy the API information from your Firebase project settings (console)
# For now, we only need these 4 settings (in double quotes):  apiKey, authDomain, projectId, and appId.
# You can add settings for other Firebase services, if needed in the future.
#
# const firebaseConfig = {
#   apiKey: ...,
#   authDomain: ...,
#   projectId: ...,
#   storageBucket: ...,
#   messagingSenderId: ...,
#   appId: ...,
#   measurementId: ...
# };
#
# For more details, see: https://firebase.google.com/docs/web/setup#config-object
// Import the functions you need from the SDKs you need
import { initializeApp } from "firebase/app";
import { getAnalytics } from "firebase/analytics";
// TODO: Add SDKs for Firebase products that you want to use
// https://firebase.google.com/docs/web/setup#available-libraries

// Your web app's Firebase configuration
// For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyB5qDuqg4c3hAvUSQc2VL8q3QgboD0UrsQ",
  authDomain: "routineapp-cfcd2.firebaseapp.com",
  projectId: "routineapp-cfcd2",
  storageBucket: "routineapp-cfcd2.firebasestorage.app",
  messagingSenderId: "641709964787",
  appId: "1:641709964787:web:fc2e16fd71b1272847a686",
  measurementId: "G-7XXZTC9SLW"
};

// Initialize Firebase
const app = initializeApp(firebaseConfig);
const analytics = getAnalytics(app);

VITE_FIREBASE_API_KEY="AIzaSyB5qDuqg4c3hAvUSQc2VL8q3QgboD0UrsQ"
VITE_FIREBASE_AUTH_DOMAIN="routineapp-cfcd2.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="routineapp-cfcd2"
VITE_FIREBASE_APP_ID="1:641709964787:web:fc2e16fd71b1272847a686"
